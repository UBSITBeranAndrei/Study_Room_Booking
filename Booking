<div class="container py-4" style="max-width: 720px;">

    <h1 class="h3 mb-3">Book a Discussion Room</h1>
    <p class="text-muted">Logged in as <strong><?= h($_SESSION['full_name'] ?? 'User') ?></strong>
        (<?= h($_SESSION['role']) ?>)</p>

    <?php if ($errors): ?>
        <div class="alert alert-danger">
            <strong>Please fix the following:</strong>
            <ul class="mb-0">
                <?php foreach ($errors as $error): ?>
                    <li><?= h($error) ?></li>
                <?php endforeach; ?>
            </ul>
        </div>
    <?php endif; ?>

    <div class="card mb-4">
        <div class="card-header">Selected Room</div>
        <div class="card-body">
            <p class="mb-1"><strong>Library:</strong> <?= h($room['library_name']) ?></p>
            <p class="mb-1"><strong>Room number:</strong> <?= h($room['room_number']) ?></p>
            <p class="mb-0"><strong>Capacity:</strong>
                <?= h($room['min_capacity']) ?> to <?= h($room['max_capacity']) ?> people</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header">Booking Details</div>
        <div class="card-body">
            <form method="post" action="process_booking.php" novalidate>
                <input type="hidden" name="room_id" value="<?= (int)$room['room_id'] ?>">
                <input type="hidden" name="csrf_token" value="<?= h($_SESSION['csrf_token']) ?>">

                <div class="mb-3">
                    <label for="booking_date" class="form-label">Booking date</label>
                    <input type="date" class="form-control" id="booking_date" name="booking_date"
                           min="<?= h($today) ?>" value="<?= h($old['booking_date'] ?? '') ?>" required>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="start_time" class="form-label">Start time</label>
                        <input type="time" class="form-control" id="start_time" name="start_time"
                               value="<?= h($old['start_time'] ?? '') ?>" required>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="end_time" class="form-label">End time</label>
                        <input type="time" class="form-control" id="end_time" name="end_time"
                               value="<?= h($old['end_time'] ?? '') ?>" required>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="topic_purpose" class="form-label">Topic or purpose</label>
                    <textarea class="form-control" id="topic_purpose" name="topic_purpose"
                              rows="3" maxlength="255" required><?= h($old['topic_purpose'] ?? '') ?></textarea>
                </div>

                <button type="submit" class="btn btn-primary">Submit Booking</button>
                <a href="javascript:history.back()" class="btn btn-secondary">Back</a>
            </form>
        </div>
    </div>

</div>
</body>
</html>
