<?php
require_once __DIR__ . '/db.php';

if (session_status() === PHP_SESSION_NONE) {
    session_start();
}
date_default_timezone_set('Asia/Manila');

$loginPage = 'login.php';

function h($value): string
{
    return htmlspecialchars((string)$value, ENT_QUOTES, 'UTF-8');
}

function stopWithMessage(int $code, string $title, string $message, ?string $linkUrl = null, ?string $linkText = null): void
{
    http_response_code($code);
    ?>
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title><?= h($title) ?></title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    </head>
    <body class="bg-light">
    <div class="container py-5" style="max-width: 640px;">
        <div class="alert alert-danger">
            <h4 class="alert-heading"><?= h($title) ?></h4>
            <p class="mb-0"><?= h($message) ?></p>
        </div>
        <?php if ($linkUrl): ?>
            <a href="<?= h($linkUrl) ?>" class="btn btn-secondary"><?= h($linkText ?? 'Back') ?></a>
        <?php endif; ?>
    </div>
    </body>
    </html>
    <?php
    exit;
}

$isAllowed = isset($_SESSION['user_id'], $_SESSION['role'])
    && in_array($_SESSION['role'], ['student', 'employee'], true);

if (!$isAllowed) {
    stopWithMessage(
        403,
        'Login required',
        'Please log in as a student or employee to book a discussion room.',
        $loginPage,
        'Go to login'
    );
}

$roomId = filter_input(INPUT_GET, 'room_id', FILTER_VALIDATE_INT, [
    'options' => ['min_range' => 1],
]);

if ($roomId === false || $roomId === null) {
    stopWithMessage(400, 'Invalid room', 'The selected room is missing or invalid.');
}

$sql = "SELECT r.room_id, r.room_number, r.min_capacity, r.max_capacity,
               l.library_id, l.library_name
        FROM rooms r
        INNER JOIN libraries l ON l.library_id = r.library_id
        WHERE r.room_id = ?";
$stmt = $conn->prepare($sql);
$stmt->bind_param('i', $roomId);
$stmt->execute();
$room = $stmt->get_result()->fetch_assoc();
$stmt->close();

if (!$room) {
    stopWithMessage(404, 'Room not found', 'The selected room does not exist.');
}

if (empty($_SESSION['csrf_token'])) {
    $_SESSION['csrf_token'] = bin2hex(random_bytes(32));
}

$errors = $_SESSION['booking_errors'] ?? [];
$old    = $_SESSION['booking_old'] ?? [];
unset($_SESSION['booking_errors'], $_SESSION['booking_old']);

$today = date('Y-m-d');
?>
